{
  "openapi": "3.1.0",
  "info": {
    "title": "VectorWatch India API",
    "description": "Annual dengue, malaria and chikungunya forecasts for 36 states/UTs, always shown next to persistence. Data is annual, latest year 2022. Horizons 2 and 3 are experimental.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "status"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/states": {
      "get": {
        "tags": [
          "data"
        ],
        "summary": "States",
        "operationId": "states_states_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/State"
                  },
                  "type": "array",
                  "title": "Response States States Get"
                }
              }
            }
          }
        }
      }
    },
    "/historical/{state_id}": {
      "get": {
        "tags": [
          "data"
        ],
        "summary": "Historical",
        "operationId": "historical_historical__state_id__get",
        "parameters": [
          {
            "name": "state_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "State Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Historical"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/forecast/{state_id}/{disease}": {
      "get": {
        "tags": [
          "forecast"
        ],
        "summary": "Forecast",
        "operationId": "forecast_forecast__state_id___disease__get",
        "parameters": [
          {
            "name": "state_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "State Id"
            }
          },
          {
            "name": "disease",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Disease"
            }
          },
          {
            "name": "include_experimental",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Also return horizons 2 and 3.",
              "default": false,
              "title": "Include Experimental"
            },
            "description": "Also return horizons 2 and 3."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForecastResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/risk-map": {
      "get": {
        "tags": [
          "risk"
        ],
        "summary": "Risk Map",
        "operationId": "risk_map_risk_map_get",
        "parameters": [
          {
            "name": "disease",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Disease"
            }
          },
          {
            "name": "year",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Forecast year. Default: next year (horizon 1).",
              "title": "Year"
            },
            "description": "Forecast year. Default: next year (horizon 1)."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RiskMap"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/model-performance": {
      "get": {
        "tags": [
          "model"
        ],
        "summary": "Model Performance",
        "operationId": "model_performance_model_performance_get",
        "parameters": [
          {
            "name": "tag",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Run whose per-fold rows to return.",
              "default": "geo_w",
              "title": "Tag"
            },
            "description": "Run whose per-fold rows to return."
          },
          {
            "name": "horizon",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "title": "Horizon"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/explanation/{state_id}/{disease}": {
      "get": {
        "tags": [
          "explanation"
        ],
        "summary": "Explanation",
        "operationId": "explanation_explanation__state_id___disease__get",
        "parameters": [
          {
            "name": "state_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "State Id"
            }
          },
          {
            "name": "disease",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Disease"
            }
          },
          {
            "name": "horizon",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 3,
              "minimum": 1,
              "default": 1,
              "title": "Horizon"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Explanation"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
