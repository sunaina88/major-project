# Stub: needs Person 5's src/api/main.py exposing app and /health
FROM python:3.11-slim
WORKDIR /app
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu
COPY requirements-stgnn.txt .
RUN pip install --no-cache-dir -r requirements-stgnn.txt fastapi uvicorn
COPY models/stgnn ./models/stgnn
COPY data/processed/graph ./data/processed/graph
COPY configs ./configs
COPY src ./src
EXPOSE 8000
HEALTHCHECK CMD python -c "import urllib.request as u; u.urlopen('http://localhost:8000/health')"
CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
