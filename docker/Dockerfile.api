FROM python:3.11-slim
WORKDIR /app
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu
COPY requirements-stgnn.txt .
RUN pip install --no-cache-dir -r requirements-stgnn.txt
COPY models ./models
COPY configs ./configs
COPY data/processed ./data/processed
COPY src ./src
ENV VW_DB_PATH=/db/vectorwatch.db
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=90s --retries=5 \
  CMD python -c "import urllib.request as u; u.urlopen('http://localhost:8000/health')"
CMD ["sh", "-c", "mkdir -p /db && python -m src.api.ingest && uvicorn src.api.main:app --host 0.0.0.0 --port 8000"]
